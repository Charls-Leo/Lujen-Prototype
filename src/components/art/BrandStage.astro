---
/**
 * Escenario de marca: el isotipo de LUJEN en una sala navy, rodeado por los objetos de lo que
 * hace (web, chat, QR de reseñas y datos). Los objetos flotan y siguen al puntero con distinta
 * profundidad; el escenario crece al entrar con el scroll (CSS scroll-driven).
 */
import { Image } from 'astro:assets';
import isotipo from '@/assets/brand/lujen-isotipo.png';

const qrModules = [
  [0, 0], [2, 0], [3, 1], [0, 2], [1, 3], [3, 3], [2, 4], [4, 2], [4, 4], [1, 4], [3, 0], [0, 4],
] as const;
---

<div class="stage-wrap container">
  <figure class="stage" data-stage>
    <div class="stage__glow" aria-hidden="true"></div>

    <Image
      class="stage__mark"
      src={isotipo}
      alt=""
      widths={[240, 420, 640]}
      sizes="(min-width: 60rem) 26vw, 46vw"
      loading="eager"
    />

    <div class="stage__object stage__object--web" style="--depth: 1.4; --float: 7s" aria-hidden="true">
      <svg viewBox="0 0 220 150">
        <rect width="220" height="150" rx="16" fill="#fff"></rect>
        <circle cx="18" cy="16" r="3.5" fill="#cfd8ea"></circle>
        <circle cx="30" cy="16" r="3.5" fill="#cfd8ea"></circle>
        <circle cx="42" cy="16" r="3.5" fill="#cfd8ea"></circle>
        <rect x="14" y="32" width="192" height="58" rx="10" fill="#176bff"></rect>
        <rect x="26" y="46" width="90" height="9" rx="4.5" fill="#fff"></rect>
        <rect x="26" y="62" width="62" height="7" rx="3.5" fill="#fff" opacity="0.6"></rect>
        <rect x="14" y="102" width="56" height="34" rx="8" fill="#e6ecf7"></rect>
        <rect x="82" y="102" width="56" height="34" rx="8" fill="#e6ecf7"></rect>
        <rect x="150" y="102" width="56" height="34" rx="8" fill="#e6ecf7"></rect>
      </svg>
    </div>

    <div class="stage__object stage__object--chat" style="--depth: 2.2; --float: 6s" aria-hidden="true">
      <svg viewBox="0 0 170 96">
        <path d="M14 0h142a14 14 0 0 1 14 14v46a14 14 0 0 1-14 14H40l-22 18 4-18h-8A14 14 0 0 1 0 60V14A14 14 0 0 1 14 0z" fill="#26c6ff"></path>
        <rect x="18" y="20" width="108" height="9" rx="4.5" fill="#081a3a"></rect>
        <rect x="18" y="38" width="74" height="9" rx="4.5" fill="#081a3a" opacity="0.45"></rect>
        <path d="M134 50l6 6 12-13" fill="none" stroke="#081a3a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </div>

    <div class="stage__object stage__object--qr" style="--depth: 1.8; --float: 8s" aria-hidden="true">
      <svg viewBox="0 0 130 158">
        <rect width="130" height="158" rx="16" fill="#fff"></rect>
        {[0, 1, 2, 3, 4].map((i) => <circle cx={29 + i * 18} cy="22" r="5.5" fill="#176bff" />)}
        <g transform="translate(25 38)">
          <rect width="80" height="80" rx="6" fill="#e6ecf7"></rect>
          {
            [
              [6, 6],
              [52, 6],
              [6, 52],
            ].map(([x, y]) => (
              <>
                <rect x={x} y={y} width="22" height="22" rx="4" fill="#081a3a" />
                <rect x={x + 7} y={y + 7} width="8" height="8" rx="2" fill="#e6ecf7" />
              </>
            ))
          }
          {qrModules.map(([x, y]) => <rect x={32 + x * 9} y={32 + y * 9} width="7" height="7" rx="1.5" fill="#081a3a" />)}
        </g>
        <rect x="35" y="132" width="60" height="8" rx="4" fill="#cfd8ea"></rect>
      </svg>
    </div>

    <div class="stage__object stage__object--data" style="--depth: 1; --float: 9s" aria-hidden="true">
      <svg viewBox="0 0 200 136">
        <defs>
          <linearGradient id="stage-bar" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#26c6ff"></stop>
            <stop offset="1" stop-color="#176bff"></stop>
          </linearGradient>
        </defs>
        <rect width="200" height="136" rx="16" fill="#0d2d8f"></rect>
        <path d="M18 108H182M18 80H182M18 52H182" stroke="#26c6ff" stroke-opacity="0.18"></path>
        {
          [38, 58, 46, 72, 64, 86].map((h, i) => (
            <rect x={26 + i * 26} y={108 - h} width="16" height={h} rx="4" fill="url(#stage-bar)" />
          ))
        }
      </svg>
    </div>

    <figcaption class="visually-hidden">
      El isotipo de Lujen rodeado por una página web, un mensaje de WhatsApp, un QR de reseñas y un
      gráfico de datos: lo que hacemos por tu negocio.
    </figcaption>
  </figure>
</div>

<script>
  // Parallax del puntero con inercia: escribe --mx/--my (-1…1) en el escenario.
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (stage && fine && !reduceMotion) {
    const target = { x: 0, y: 0 };
    const current = { x: 0, y: 0 };
    let frame = 0;

    const tick = () => {
      current.x += (target.x - current.x) * 0.08;
      current.y += (target.y - current.y) * 0.08;
      stage.style.setProperty('--mx', current.x.toFixed(3));
      stage.style.setProperty('--my', current.y.toFixed(3));
      const settled = Math.abs(target.x - current.x) < 0.001 && Math.abs(target.y - current.y) < 0.001;
      frame = settled ? 0 : requestAnimationFrame(tick);
    };

    const start = () => {
      if (!frame) frame = requestAnimationFrame(tick);
    };

    stage.addEventListener('pointermove', (event) => {
      const box = stage.getBoundingClientRect();
      target.x = ((event.clientX - box.left) / box.width) * 2 - 1;
      target.y = ((event.clientY - box.top) / box.height) * 2 - 1;
      start();
    });

    stage.addEventListener('pointerleave', () => {
      target.x = 0;
      target.y = 0;
      start();
    });
  }
</script>

<style>
  .stage {
    --mx: 0;
    --my: 0;
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--brand-deep-navy);
    isolation: isolate;
  }

  .stage__glow {
    position: absolute;
    inset: -20%;
    z-index: -1;
    background:
      radial-gradient(38% 34% at 50% 52%, rgb(23 107 255 / 0.55), transparent 70%),
      radial-gradient(30% 30% at 72% 30%, rgb(38 198 255 / 0.28), transparent 70%),
      radial-gradient(40% 40% at 22% 78%, rgb(13 45 143 / 0.9), transparent 70%);
    translate: calc(var(--mx) * -2%) calc(var(--my) * -2%);
  }

  .stage :global(.stage__mark) {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 52%;
    height: auto;
    translate: calc(-50% + var(--mx) * 10px) calc(-50% + var(--my) * 8px);
    filter: drop-shadow(0 30px 60px rgb(4 13 32 / 0.6));
  }

  .stage__object {
    position: absolute;
    translate: calc(var(--mx) * var(--depth) * 16px) calc(var(--my) * var(--depth) * 12px);
    filter: drop-shadow(0 24px 30px rgb(4 13 32 / 0.45));
  }

  .stage__object svg {
    width: 100%;
    height: auto;
  }

  .stage__object--web {
    top: 7%;
    left: 6%;
    width: 46%;
    rotate: -6deg;
  }

  .stage__object--chat {
    top: 12%;
    right: 5%;
    width: 36%;
    rotate: 5deg;
  }

  .stage__object--qr {
    bottom: 8%;
    left: 9%;
    width: 27%;
    rotate: 7deg;
  }

  .stage__object--data {
    right: 6%;
    bottom: 10%;
    width: 42%;
    rotate: -4deg;
  }

  @media (min-width: 48rem) {
    .stage {
      aspect-ratio: 16 / 8.5;
    }

    .stage :global(.stage__mark) {
      width: 24%;
    }

    .stage__object--web {
      top: 12%;
      left: 9%;
      width: 22%;
    }

    .stage__object--chat {
      top: 14%;
      right: 12%;
      width: 16%;
    }

    .stage__object--qr {
      bottom: 10%;
      left: 22%;
      width: 11%;
    }

    .stage__object--data {
      right: 9%;
      bottom: 12%;
      width: 20%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .stage__object {
      animation: stage-float var(--float) var(--ease-in-out) infinite alternate;
    }

    .stage__object--chat {
      animation-delay: -2s;
    }

    .stage__object--data {
      animation-delay: -4s;
    }

    /* El escenario crece y suaviza sus esquinas mientras entra en la vista. */
    @supports (animation-timeline: view()) {
      .stage {
        animation: stage-grow linear both;
      }

      /* animation-timeline va en una regla aparte (más específica): si comparte regla con el atajo
         `animation`, el minificador los fusiona en una declaración inválida y la animación se pierde. */
      .stage-wrap > .stage {
        animation-timeline: view();
        animation-range: entry 0% cover 40%;
      }
    }
  }

  @keyframes stage-float {
    from {
      transform: translateY(-8px);
    }
    to {
      transform: translateY(10px);
    }
  }

  @keyframes stage-grow {
    from {
      transform: scale(0.88);
      border-radius: calc(var(--radius-media) * 2.5);
    }
    to {
      transform: none;
      border-radius: var(--radius-media);
    }
  }
</style>
