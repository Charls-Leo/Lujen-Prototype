# Origen público (sin la ruta base): canonical, sitemap y Open Graph.
# Astro usa este valor por defecto para GitHub Pages; no hace falta crear un .env.
SITE_URL=https://charls-leo.github.io

# Número de WhatsApp comercial en formato internacional, solo dígitos (ej. 57 + número).
# Si queda vacío, los enlaces abren WhatsApp con el mensaje listo para elegir el contacto.
PUBLIC_WHATSAPP_NUMBER=3122797754
